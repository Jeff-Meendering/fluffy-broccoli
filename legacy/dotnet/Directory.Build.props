<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.3.0</Version>
    <InformationalVersion>0.3.0-pilot.1</InformationalVersion>
    <!-- Source and any produced package identify the same license as LICENSE/NOTICE. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 PII Explorer contributors</Copyright>
    <PackageProjectUrl>https://github.com/Jeff-Meendering/fluffy-broccoli</PackageProjectUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
