<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PiiExplorer.App.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F8" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InputBrush" Color="#FAFBFC" />
          <SolidColorBrush x:Key="LineBrush" Color="#DCE3EA" />
          <SolidColorBrush x:Key="InkBrush" Color="#203240" />
          <SolidColorBrush x:Key="MutedBrush" Color="#617281" />
          <SolidColorBrush x:Key="AccentBrush" Color="#087D73" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#066A62" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#E0F2EE" />
          <SolidColorBrush x:Key="HoverBrush" Color="#EDF2F5" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9B631B" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#173541" />
          <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#A9B8C4" />
          <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#F3F5F8" />
          <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#F3F5F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#10171F" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#19232E" />
          <SolidColorBrush x:Key="InputBrush" Color="#131D27" />
          <SolidColorBrush x:Key="LineBrush" Color="#334352" />
          <SolidColorBrush x:Key="InkBrush" Color="#E4EBF1" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A1B1C0" />
          <SolidColorBrush x:Key="AccentBrush" Color="#63D3BF" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#8CE3D3" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#102B28" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#254A48" />
          <SolidColorBrush x:Key="HoverBrush" Color="#263542" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F1BE70" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#142730" />
          <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#536979" />
          <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#19232E" />
          <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#19232E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#087D73" />
        <ColorPaletteResources x:Key="Dark" Accent="#63D3BF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox"><Setter Property="Padding" Value="11,7" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="PlaceholderForeground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ComboBox"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="30" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="0.7" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="Border.card"><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="14,11" /></Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle"><Setter Property="Fill" Value="{DynamicResource SelectionBrush}" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  </Application.Styles>
</Application>
